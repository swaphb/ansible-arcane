{
  "services": {
    "arcane": {
      "github_repository": "getarcaneapp/arcane",
      "tag_prefix": "v",
      "variable": "arcane_version",
      "files": [
        "roles/arcane/defaults/main.yml",
        "roles/arcane_agent/defaults/main.yml",
        "group_vars/arcane_manager.yml.example",
        "group_vars/arcane_agents.yml.example",
        "README.md"
      ]
    },
    "newt": {
      "github_repository": "fosrl/newt",
      "tag_prefix": "",
      "strip_leading_v": true,
      "discovery": "tags",
      "variable": "arcane_newt_version",
      "files": [
        "roles/arcane/defaults/main.yml",
        "group_vars/arcane_manager.yml.example",
        "README.md"
      ]
    },
    "pangolin_cli": {
      "github_repository": "fosrl/cli",
      "tag_prefix": "",
      "strip_leading_v": true,
      "discovery": "tags",
      "variable": "arcane_pangolin_cli_version",
      "files": [
        "roles/arcane/defaults/main.yml",
        "roles/arcane_agent/defaults/main.yml",
        "group_vars/arcane_manager.yml.example",
        "group_vars/arcane_agents.yml.example",
        "README.md"
      ]
    }
  }
}
