{
  "services": {
    "arcane": {
      "github_repository": "getarcaneapp/arcane",
      "tag_prefix": "v",
      "variable": "arcane_version"
    },
    "newt": {
      "github_repository": "fosrl/newt",
      "tag_prefix": "",
      "strip_leading_v": true,
      "discovery": "tags",
      "variable": "arcane_newt_version"
    },
    "pangolin_cli": {
      "github_repository": "fosrl/cli",
      "tag_prefix": "",
      "strip_leading_v": true,
      "discovery": "tags",
      "variable": "arcane_pangolin_cli_version"
    }
  }
}
